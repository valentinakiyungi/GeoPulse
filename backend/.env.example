# Copy to backend/.env and adjust. Every value is optional.

# Ultralytics weights. Default: YOLOv8-nano OBB trained on DOTA aerial imagery
# (plane, ship, storage tank, small/large vehicle, swimming pool, courts, bridge, harbor, ...).
# Downloaded automatically on first use. Try yolov8s-obb.pt / yolov8m-obb.pt for higher accuracy,
# or yolov8n.pt for the general COCO classes.
GEOPULSE_MODEL=models/yolov8n-obb.pt
# "" = auto, "cpu", "0" (first CUDA GPU), "mps" (Apple Silicon)
GEOPULSE_DEVICE=
GEOPULSE_CONFIDENCE=0.25
GEOPULSE_IOU=0.45
# Large frames are cut into overlapping tiles of this size for small-object detection.
GEOPULSE_TILE_SIZE=1024
GEOPULSE_TILE_OVERLAP=0.2
GEOPULSE_MAX_UPLOAD_MB=100
GEOPULSE_MAX_JOBS=200
GEOPULSE_JOB_TTL_SECONDS=21600
# Load the model at startup instead of on the first request.
GEOPULSE_WARMUP=true
GEOPULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
